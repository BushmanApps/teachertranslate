# EscapeBase44 — local-dev
# .env, .env.*, dist, node_modules are already ignored above.
# Make sure .env.example IS tracked so a fresh clone has the template.
!.env.example
# Function-supervisor scratch wrappers
.escapebase44/dev/.cache/
# The backend's Python bytecode (written as it runs; the builder commits the whole worktree)
__pycache__/

# EscapeBase44 — mobile kit: the native projects are generated by
# `npm run mobile:setup` (and by the Mobile release workflow), never committed.
ios/
android/
