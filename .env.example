# Local development environment for this app.
# Copy this file to `.env.local` and fill in the blanks.
# `.env.local` is gitignored — it carries your secrets and must NOT be committed.
#
# The post-migration page has a 'Download .env.local' button that fills in
# every secret with your actual deployed values, so you don't have to do
# this by hand — see the README's `Running locally` section.

# ─── Frontend (Vite reads VITE_*-prefixed vars at build time) ───
# Your app's stable identity. Don't change.
VITE_BASE44_APP_ID=69fc81cf4f6a0ae5ab617e2b
# The address the frontend calls for /api. Locally that is the vite dev server itself, which proxies /api to the backend on :8000. Keep it absolute: Base44's template turns an empty value into `null`.
VITE_BASE44_BACKEND_URL=http://localhost:5173
# Leave empty: login/logout redirects then stay relative to whatever host serves the app. `@base44/vite-plugin` would use it for its own dev proxy, which we don't run.
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# ─── Dev stack (the laptop values; production has its own) ───
# Public URL the backend mints links against: vite itself, which proxies /api → uvicorn :8000.
BASE_URL=http://localhost:5173
# Where the backend reads index.html on startup; the dev script creates it empty.
FRONTEND_DIR=dist
# Routes /functions/{name} to the local supervisor instead of the deployed function URL.
ESCAPEBASE44_DEV_FUNCTIONS_BASE_URL=http://localhost:8002
# Which of these values your backend functions receive, comma-separated — the downloaded
# .env.local fills this with exactly what they get in production. Left empty, every value reaches every function.
ESCAPEBASE44_FUNCTION_ENV_ALLOWLIST=

# ─── Facts of this deployment (the same values as `.escapebase44/config.json`) ───
MONGO_DB=teachertranslate
APP_ID=69fc81cf4f6a0ae5ab617e2b
BASE44_ORIGINAL_APP_ID=69fc81cf4f6a0ae5ab617e2b
SERVICE_PRINCIPAL_ID=16da470c-867e-4fbc-b730-d4fdf0800883
EMAIL_FROM=no-reply@eb44.app
BASE44_FALLBACK_URL=https://base44.app
GOOGLE_OAUTH_CALLBACK_URL=https://auth.eb44.app/oauth/google
GOOGLE_CLIENT_ID=588115625231-kgfml0mr6nflgi8pqtfp8pava5nct5rr.apps.googleusercontent.com
LLM_PROVIDER=openrouter
STORAGE_PROVIDER=s3
S3_BUCKET=eb44-assets
S3_REGION=ap-southeast-2
S3_ENDPOINT_URL=https://toeynygydmamcxnxakhb.storage.supabase.co/storage/v1/s3
S3_PUBLIC_URL=https://toeynygydmamcxnxakhb.storage.supabase.co/storage/v1/object/public/eb44-assets

# ─── Secrets (blank here; the post-migration page's Download .env.local fills them) ───
MONGO_URL=
APP_JWT_SECRET=
SERVICE_JWT_SECRET=
EB44_CRON_SECRET=
RESEND_API_KEY=
GOOGLE_CLIENT_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
VERCEL_TOKEN=
SUPABASE_TOKEN=
BASE44_APP_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
