{
  "name": "ReportShareLog",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user who sent the report"
    },
    "sender_user_id": {
      "type": "string",
      "description": "Base44 user ID of the sender"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "description": "Email address the report was sent to"
    },
    "translation_id": {
      "type": "string",
      "description": "ID of the Translation that was shared"
    },
    "share_mode": {
      "type": "string",
      "enum": [
        "honest_helpful",
        "hilarious",
        "brutal",
        "all"
      ],
      "description": "Which translation mode was shared"
    },
    "description": {
      "type": "string",
      "description": "Optional description or note (up to 1000 characters)"
    }
  },
  "required": [
    "sender_email",
    "recipient_email",
    "translation_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}