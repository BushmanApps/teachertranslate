{
  "name": "DeletedAccountLog",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email of the deleted account (lowercased)"
    },
    "scans_used": {
      "type": "number",
      "default": 0,
      "description": "Free scans used at the time of deletion"
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the account was deleted"
    },
    "description": {
      "type": "string",
      "description": "Optional description or note (up to 1000 characters)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}