{
  "name": "UsageAlert",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user flagged for excessive usage"
    },
    "description": {
      "type": "string",
      "description": "Optional description or note (up to 1000 characters)"
    },
    "alert_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the alert email was sent"
    },
    "scan_count": {
      "type": "number",
      "description": "Number of scans in the 21-day window when the alert was triggered"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}