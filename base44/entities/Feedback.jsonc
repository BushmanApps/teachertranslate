{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person giving feedback"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the person giving feedback"
    },
    "description": {
      "type": "string",
      "description": "Optional description or note (up to 1000 characters)"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "General",
        "Bug Report",
        "Feature Request",
        "Question"
      ],
      "default": "General",
      "description": "Category of feedback"
    },
    "message": {
      "type": "string",
      "description": "The feedback message content"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}