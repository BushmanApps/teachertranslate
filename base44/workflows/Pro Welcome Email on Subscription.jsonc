{
  "name": "Pro Welcome Email on Subscription",
  "description": "Sends a branded Pro welcome email (plus admin copy) when a UserProfile's is_subscribed is set to true \u2014 covers Stripe purchases, checkSubscription syncs, and manual backend enables.",
  "trigger": {
    "condition": "${ (.trigger.data.is_subscribed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "UserProfile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pro_welcome_email_on_subscription",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendProWelcomeEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendProWelcomeEmail"
  }
}